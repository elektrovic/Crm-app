# --- Innlogging (Microsoft Entra ID) ---
# Registrer appen i Entra ID > App registrations. Redirect URI:
#   https://<domene>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Generer med: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://bruker:passord@localhost:5432/montorappen

# --- Tripletex ---
# Consumer token fås fra Tripletex etter godkjent API 2.0-registrering.
TRIPLETEX_CONSUMER_TOKEN=
# Employee token for integrasjonsbrukeren.
TRIPLETEX_EMPLOYEE_TOKEN=
# Bruk https://api-test.tripletex.tech/v2 mot testmiljøet.
TRIPLETEX_BASE_URL=https://api.tripletex.io/v2

# --- ABAX ---
# OAuth2 client credentials fra developers.abax.cloud
ABAX_CLIENT_ID=
ABAX_CLIENT_SECRET=
ABAX_BASE_URL=https://api.abax.cloud

# --- Organisasjon ---
# Kunde-ID for Halland. Ligger på alle rader slik at flerkundestøtte
# senere ikke krever migrering av databasen.
DEFAULT_TENANT_ID=halland

# --- SMS til kunde ---
# Uten SMS_LEVERANDOR er SMS avslått, og knappen vises ikke i appen.
# sveve | link
SMS_LEVERANDOR=
SMS_AVSENDER=Halland
SVEVE_BRUKER=
SVEVE_PASSORD=

# --- Firmaopplysninger brukt i meldinger til kunde ---
FIRMANAVN=Halland Gruppen
# Nummeret kunden kan ringe tilbake på.
KONTAKTTELEFON=

# --- E-post (Microsoft Graph) ---
# Bruker samme app-registrering som innloggingen. Krever applikasjons-
# tillatelsen Mail.Send med administratorsamtykke.
GRAPH_AVSENDER=
# Hvem bestillingslista fra montøren går til. Komma mellom flere.
BESTILLING_MOTTAKER=

# --- AI-triagering av henvendelser ---
# Uten AI_LEVERANDOR er triagering avslått, og knappen vises ikke.
# claude | pocket
AI_LEVERANDOR=
ANTHROPIC_API_KEY=
# Overstyr modellen om ønskelig. Standard er claude-opus-5.
ANTHROPIC_MODELL=

# --- Kryptering ---
# Krypterer de personlige Tripletex-tokenene i databasen.
# Generer med: openssl rand -base64 32
KRYPTERINGSNOKKEL=

# --- Synk mot Tripletex ---
# Nøkkel en planlagt jobb bruker for å utløse synk uten innlogging.
# Generer med: openssl rand -base64 32
SYNK_NOKKEL=

# --- Bestilling av materiell ---
# epost virker i dag. ahlsell_edi krever e-handelsavtale.
BESTILLINGSVEI=epost
# Vårt kundenummer hos grossisten, som følger med bestillingen.
GROSSIST_KUNDENUMMER=
